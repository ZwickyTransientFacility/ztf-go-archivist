# Example crontab. nightly.sh starts tonight's public and partnership runs and
# the rerunner, and waits for them; see its header for the environment it
# reads. The schedule is meant to be read in Pacific time (set TZ or CRON_TZ
# to America/Los_Angeles): ZTF's night is over well before the 7-hour run ends.
#minute   Hour   Day of Month       Month          Day of Week        Command
# (0-59)  (0-23)     (1-31)    (1-12 or Jan-Dec)  (0-6 or Sun-Sat)
10 0 * * * /usr/local/bin/nightly.sh
